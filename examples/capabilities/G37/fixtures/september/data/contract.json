{
 "schema": "solaris.csv-reconcile/1",
 "timezone": "UTC",
 "facts": {
  "file": "orders.csv",
  "grain": ["order_id"],
  "columns": {"order_id": "str", "customer_id": "str", "amount": "decimal", "currency": "str", "status": "str", "event_time": "timestamp", "loaded_at": "timestamp", "updated_at": "timestamp"},
  "required": ["amount", "currency", "event_time"],
  "duplicate_policy": "latest:updated_at",
  "status_column": "status",
  "exclude_status": ["test"],
  "loaded_at_column": "loaded_at"
 },
 "dimension": {"file": "customers.csv", "key": "customer_id", "attributes": ["region"],
               "columns": {"customer_id": "str", "region": "str", "updated_at": "timestamp"}, "duplicate_policy": "reject"},
 "window": {"column": "event_time", "start": "2026-09-01T00:00:00Z", "end": "2026-10-01T00:00:00Z"},
 "as_of": "2026-10-02T00:00:00Z",
 "metrics": [{"name": "revenue", "agg": "sum", "column": "amount", "by": ["region", "currency"]}]
}
