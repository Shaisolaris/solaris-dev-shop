  "default_capability": "solaris.backend-developer",
  "route_overrides": [
    {
      "keywords": ["code review", "review this code", "pull request"],
      "capabilities": ["solaris.code-reviewer"]
    },
    {
      "keywords": ["build me a landing page", "landing page"],
      "capabilities": [
        "solaris.full-stack-developer",
        "solaris.ui-ux-designer",
        "solaris.qa-engineer"
      ]
    }
  ],
  "coordinator_authority": {
    "meta.chief-of-staff": {
      "allowed_namespaces": ["solaris", "meta"],
      "forbidden_domains": ["health", "finance_personal", "travel"],
      "escalate_to": "owner"
    },
    "alfred.coordinator": {
      "allowed_namespaces": ["alfred", "meta"],
      "forbidden_domains": [
        "engineering",
        "design",
        "marketing",
        "security",
        "qa",
        "legal",
        "mobile"
      ],
      "escalate_to": "owner"
    }
  },
