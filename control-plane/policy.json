  "assignment_authority_bounds": [
    "stay within declared capability authority",
    "no production deploy without human",
    "no spend / message_send / external mutation without human",
    "no autonomous scope expansion"
  ],
  "assignment_must_not": [
    "coordinator_performs_specialist_work",
    "phantom_credit_without_invocation",
    "autonomous_scope_expansion",
    "alfred_personal_data_in_solaris_packet",
    "credentials_in_handoff"
  ],
  "closure_evidence_required": [
    "routing_decision_with_named_roles",
    "assignment_packet_with_task_description",
    "list_of_capabilities_invoked_or_queued",
    "coordinator_did_not_perform_work"
  ],
  "high_risk_extra_evidence": [
    "human_confirmation_record",
    "permission_scope_snapshot"
  ],
  "closure_acceptance": "Every named capability was invoked or explicitly queued; no phantom credits; coordinator did not perform specialist work; material decisions escalated.",
  "closure_redaction": "Strip credentials, tokens, private health/finance/personal content, raw connector data from packets, logs, and evidence."
}
