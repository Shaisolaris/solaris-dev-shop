{
  "schema_version": "1.0.0",
  "kind": "capability",
  "identity": {
    "id": "solaris.engineering-design",
    "name": "engineering-design",
    "version": "1.1.0",
    "namespace": "solaris",
    "domain": "specialized",
    "owner": "solaris-specialized",
    "maturity": "L2",
    "summary": "Engineering design docs and ADRs; no code deploy authority.",
    "tags": [
      "specialized",
      "design",
      "product-design-creative",
      "accessibility",
      "licensing"
    ]
  },
  "trigger": {
    "when": [
      "design docs",
      "ADRs",
      "system design reviews"
    ],
    "exclusions": [
      "production deploy",
      "secret handling beyond redaction guidance"
    ],
    "priority": 55
  },
  "inputs": {
    "fields": [
      {
        "name": "task",
        "type": "string",
        "required": true,
        "sensitivity": "internal",
        "description": "Technical task description"
      },
      {
        "name": "repo_path",
        "type": "path",
        "required": true,
        "sensitivity": "internal",
        "description": "Project workspace or synthetic fixture repo"
      },
      {
        "name": "stack_hint",
        "type": "string",
        "required": false,
        "sensitivity": "public",
        "description": "Optional stack hint; repository detection still required"
      }
    ],
    "missing_behavior": "ask",
    "must_not_emit": []
  },
  "outputs": {
    "fields": [
      {
        "name": "deliverable",
        "type": "markdown",
        "required": true,
        "sensitivity": "internal",
        "description": "Primary technical deliverable (code list, plan, or report)"
      },
      {
        "name": "evidence_receipt",
        "type": "command_output",
        "required": true,
        "sensitivity": "internal",
        "description": "Tests/plan/preflight output with pass/fail counts or gate notes"
      },
      {
        "name": "gate_line",
        "type": "string",
        "required": true,
        "sensitivity": "public",
        "description": "Literal Gate: passed"
      },
      {
        "name": "provenance_ledger",
        "type": "markdown",
        "required": true,
        "sensitivity": "internal",
        "description": "Pinned sources with URL, title, date, license, and what was taken"
      },
      {
        "name": "partial_or_blocked_note",
        "type": "string",
        "required": true,
        "sensitivity": "internal",
        "description": "Explicit PARTIAL or BLOCKED when tools/licenses/assets unavailable - never invent artifacts"
      }
    ],
    "missing_behavior": "fail_closed",
    "destination": "project workspace",
    "quality_threshold": "SELF-QA GATE all yes; evidence executed not assumed; stack detected",
    "must_not_emit": [
      "secrets",
      "tokens",
      "production credentials",
      "Desktop/the coding agent personal paths as required inputs",
      "unlicensed fonts, models, stock, or audio presented as cleared",
      "invented Figma/Blender/FreeCAD/Unity tool outputs"
    ]
  },
  "authority": {
    "role": "engineering-designer",
    "can_decide": [
      "implementation details within declared stack after repository detection",
      "test layout for in-scope changes",
      "preflight tool selection among granted tools"
    ],
    "cannot_decide": [
      "production deploy without explicit human confirmation",
      "commit credentials, tokens, or private personal data",
      "force-push or rewrite shared repository history",
      "read Desktop/the coding agent or Alfred personal-data directories",
      "silent credential rotation or secret file edits"
    ],
    "escalation": "delivery-lead or cto for scope; security-auditor for authz/secrets risk",
    "approval_points": [
      "production deploy or apply",
      "credential or secret changes",
      "destructive data or history operations"
    ]
  },
  "permissions": {
    "default_deny": true,
    "scopes": [
      {
        "action": "read",
        "resource": "project/**",
        "mode": "allow"
      },
      {
        "action": "write",
        "resource": "project/**",
        "mode": "allow",
        "notes": "project code/docs only; never secrets"
      },
      {
        "action": "exec",
        "resource": "project-test-runner",
        "mode": "allow"
      },
      {
        "action": "network",
        "resource": "external-apis",
        "mode": "require_human"
      },
      {
        "action": "deploy",
        "resource": "production",
        "mode": "deny"
      },
      {
        "action": "spend",
        "resource": "cloud-billing",
        "mode": "deny"
      },
      {
        "action": "mutate_external",
        "resource": "third-party",
        "mode": "require_human"
      },
      {
        "action": "message_send",
        "resource": "external-channels",
        "mode": "require_human"
      }
    ],
    "human_confirmation_required": [
      "production deploy or apply",
      "new or rotated credentials",
      "external network mutations",
      "any force-push or history rewrite (default refuse)"
    ]
  },
  "tools": [
    {
      "name": "read_file",
      "purpose": "read project sources and skill references",
      "required": true
    },
    {
      "name": "write_file",
      "purpose": "write scoped project changes",
      "required": true
    },
    {
      "name": "run_terminal_command",
      "purpose": "run tests and local tooling preflight",
      "required": true
    }
  ],
  "data_policy": {
    "classifications": [
      "internal",
      "confidential"
    ],
    "residency": "project_store",
    "redaction": "Never log secrets, tokens, connection strings, or personal Desktop paths; scrub credentials from evidence.",
    "may_leave_host": false,
    "prohibited": [
      "production credentials in git",
      "raw customer PII in fixtures",
      "Alfred personal health/finance content",
      "control Mac Desktop/the coding agent personal paths",
      "force-push as recovery default",
      "unlicensed fonts, models, stock, or audio",
      "publishing or purchasing assets autonomously",
      "executing untrusted creative plugins",
      "client private media without authorization"
    ],
    "declared_access": [
      {
        "kind": "filesystem",
        "target": "project/**",
        "mode": "read_write"
      },
      {
        "kind": "filesystem",
        "target": "project/tests/**",
        "mode": "read_write"
      }
    ]
  },
  "dependencies": {
    "references": [
      "SKILL.md",
      "rules.md",
      "learnings.md",
      "plugin.json",
      "depth-2026-06.md",
      "freecad-mcp-operator.md",
      "kicad-pcb-note.md"
    ],
    "scripts": [],
    "binaries": [],
    "mcps": [],
    "connectors": [],
    "models": [],
    "platforms": [
      "any"
    ],
    "preflight": {
      "checks": [
        {
          "id": "skill-md",
          "kind": "file_exists",
          "target": "SKILL.md",
          "required": true
        },
        {
          "id": "workspace",
          "kind": "custom",
          "target": "project root is a git worktree or synthetic fixture repo",
          "required": true
        },
        {
          "id": "stack-detect",
          "kind": "custom",
          "target": "detect stack from repository lockfiles/manifests before applying defaults",
          "required": true
        },
        {
          "id": "ref-rules-md",
          "kind": "file_exists",
          "target": "rules.md",
          "required": false
        },
        {
          "id": "ref-learnings-md",
          "kind": "file_exists",
          "target": "learnings.md",
          "required": false
        },
        {
          "id": "ref-plugin-json",
          "kind": "file_exists",
          "target": "plugin.json",
          "required": false
        },
        {
          "id": "ref-depth-2026-06-md",
          "kind": "file_exists",
          "target": "depth-2026-06.md",
          "required": false
        },
        {
          "id": "ref-freecad-mcp-operator-md",
          "kind": "file_exists",
          "target": "freecad-mcp-operator.md",
          "required": false
        },
        {
          "id": "ref-kicad-pcb-note-md",
          "kind": "file_exists",
          "target": "kicad-pcb-note.md",
          "required": false
        }
      ],
      "on_failure": "fail_closed"
    }
  },
  "procedure": {
    "summary": "Detect repository stack, preflight tools, execute scoped work, prove with evidence, never silent-deploy.",
    "steps": [
      {
        "id": "load-contract",
        "action": "Read SKILL.md surface and available references; load capability.contract.json authority",
        "uses_tools": [
          "read_file"
        ],
        "uses_data": [
          "project/**"
        ]
      },
      {
        "id": "stack-detect",
        "action": "Detect stack from repository manifests/lockfiles; do not assume a default stack from skill prose",
        "uses_tools": [
          "read_file",
          "run_terminal_command"
        ],
        "uses_data": [
          "project/**"
        ]
      },
      {
        "id": "preflight",
        "action": "Preflight required tools/files; block if unavailable rather than inventing",
        "uses_tools": [
          "run_terminal_command",
          "read_file"
        ],
        "uses_data": [
          "project/**"
        ]
      },
      {
        "id": "execute",
        "action": "Perform scoped technical work within permissions; write only project paths",
        "uses_tools": [
          "read_file",
          "write_file",
          "run_terminal_command"
        ],
        "uses_data": [
          "project/**",
          "project/tests/**"
        ]
      },
      {
        "id": "prove",
        "action": "Run tests/plan/dry-run and capture receipts; refuse Gate: passed without evidence",
        "uses_tools": [
          "run_terminal_command"
        ],
        "uses_data": [
          "project/**"
        ]
      },
      {
        "id": "accessibility-licensing-review",
        "action": "Run accessibility, licensing, critique, and tool-availability checks; PARTIAL/BLOCKED when tools or licenses missing",
        "uses_tools": [],
        "uses_data": []
      },
      {
        "id": "gate",
        "action": "Execute SELF-QA including no silent deploy/credential/history rewrite",
        "uses_tools": [],
        "uses_data": []
      }
    ],
    "decision_points": [
      "stack detected vs stack_hint conflict \u2192 trust repository",
      "deploy/apply requested \u2192 require human (never silent)",
      "missing tool \u2192 blocked envelope, not invented substitute"
    ],
    "bounded_recovery": "Retry once on flaky local tests; if tool unavailable or permission denied, emit blocked envelope and preserve partial work"
  },
  "evidence": {
    "required_artifacts": [
      "deliverable path list or plan",
      "preflight or test/plan command output",
      "stack detection note",
      "Gate: passed line",
      "provenance_ledger",
      "partial_or_blocked_note"
    ],
    "acceptance": "Stack detected from repo; tools preflighted; evidence executed; deploy/credentials/history rewrite never silent; Gate: passed only if SELF-QA all yes",
    "redaction": "Strip tokens, passwords, connection strings, and personal absolute home paths from receipts",
    "forward_tests": [
      "synthetic PR review with boundary findings"
    ],
    "receipts": [
      "command stdout",
      "file list"
    ]
  },
  "failure": {
    "blocked_state": "BLOCKED: missing stack, unavailable tool, denied permission, or missing evidence",
    "retry_budget": {
      "max_attempts": 2,
      "backoff": "immediate-then-stop"
    },
    "fallback": "Return partial work on disk with explicit failed gate and human next action",
    "escalation": "delivery-lead for scope; devops-engineer for environment; security-auditor for secrets",
    "rollback": "git restore uncommitted experiments only with human consent; never force-push; never rewrite shared history",
    "preserve_partial": true
  },
  "observability": {
    "events": [
      "invocation",
      "preflight",
      "result",
      "error",
      "evidence",
      "blocked"
    ],
    "redact_fields": [
      "env.secrets",
      "connection_string",
      "authorization_header",
      "token"
    ],
    "metrics": [
      "latency_ms",
      "tests_passed",
      "tests_failed",
      "preflight_ok"
    ]
  },
  "compatibility": {
    "providers": [
      "the coding agent",
      "codex",
      "grok",
      "kimi"
    ],
    "min_runtime": "skill-runtime/1.0",
    "api_stability": "stable",
    "breaks_with": [],
    "adapter_invariants": [
      "authority",
      "permissions",
      "acceptance",
      "data_policy",
      "tools",
      "failure",
      "evidence"
    ]
  },
  "provenance": {
    "source": "solaris/employees/specialized/engineering-design (technical hardening wave)",
    "license": "MIT",
    "absorbed_from": [
      "existing SKILL.md OUTPUT CONTRACT + SELF-QA GATE",
      "skill-runtime-contract",
      "skill-wave-product-design-creative-20260724"
    ],
    "publisher": "Solaris Dev Shop"
  },
  "lifecycle": {
    "status": "shadow",
    "channel": "dev",
    "rollback_target": "1.0.0",
    "learning_promotion": "via reviewed learnings.md only"
  },
  "validation": {
    "deterministic_checks": [
      "python3 scripts/skill_runtime_contract.py validate solaris/employees/specialized/engineering-design/capability.contract.json"
    ],
    "forward_tests": [
      "fixtures/evaluation/product-design-creative/forward/*"
    ],
    "adversarial_tests": [
      "fixtures/evaluation/product-design-creative/adversarial/*"
    ],
    "acceptance_rubric": "L2 packaging + four technical scenarios in tests/solaris/technical"
  },
  "skill_md": {
    "path": "SKILL.md",
    "max_surface_lines": 220,
    "required_blocks": [
      "OUTPUT_CONTRACT",
      "SELF_QA_GATE",
      "EXEMPLAR",
      "HARD_NUMBERS",
      "WHEN_TO_INVOKE"
    ],
    "references": [
      "rules.md",
      "learnings.md",
      "plugin.json",
      "depth-2026-06.md",
      "freecad-mcp-operator.md",
      "kicad-pcb-note.md"
    ]
  }
}
