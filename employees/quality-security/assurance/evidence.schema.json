{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solaris.local/schemas/assurance-evidence.schema.json",
  "title": "Quality OS gate evidence",
  "schema_version": "1.0.0",
  "type": "object",
  "required": [
    "gate",
    "role",
    "summary",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "gate": {
      "type": "string",
      "enum": [
        "functional",
        "ux",
        "accessibility",
        "security",
        "privacy",
        "legal_risk",
        "compliance",
        "requirements",
        "design",
        "performance",
        "release"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "blocking_open": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string"
    },
    "reviewed": {
      "description": "What the reviewer examined: the artifact revision and/or per-file sha256 (G05 revision binding)",
      "type": "object",
      "properties": {
        "revision": { "type": "string", "pattern": "^(?:[0-9a-f]{7,64}|sha256:[0-9a-f]{64})$" },
        "digests": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 10000,
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "anyOf": [{ "required": ["revision"] }, { "required": ["digests"] }],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
